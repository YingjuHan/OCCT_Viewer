# Config file for the @PROJECT_NAME@ package
# ===============================

@PACKAGE_INIT@

if (NOT TARGET RWBase)
  include (${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake)
endif()

# Libraries
# =========
set (_@PROJECT_NAME@_KNOWN_LIBRARIES
  RWBase
  ViewBase
  RWShape
  RWShapeConv
  ViewShape
  ViewDim
  RWCae
  RWMed
  RWVtk
  RWMeshConv
  RWMeshExchanger
  ViewCae
  ViewCaeGeom
  Viewer
  FileExchange
  DrawBase
  RWCaeTest
  RWShapeTest
  ViewBaseTest
  ViewCaeTest
  ViewShapeTest
  ViewDraw
)

set(@PROJECT_NAME@_LIBRARIES "")
foreach (_lib IN LISTS _@PROJECT_NAME@_KNOWN_LIBRARIES)
  if (TARGET ${_lib})
    list (APPEND @PROJECT_NAME@_LIBRARIES ${_lib})
  endif()
endforeach()
