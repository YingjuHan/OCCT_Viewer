# Runtime search paths shared by the debugger and interactive DRAW scripts.
if (COMMAND occtviewer_draw_runtime_dirs)
  return()
endif()

function (occtviewer_draw_runtime_dirs output configuration)
  string (TOUPPER "${configuration}" _conf_uc)
  set (_runtime_dirs ${3RDPARTY_DLL_DIRS_${_conf_uc}} ${3RDPARTY_DLL_DIRS})
  if (WIN32)
    get_filename_component (_compiler_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
    list (APPEND _runtime_dirs "${OpenCASCADE_BINARY_DIR}" "${_compiler_dir}")
    # MinGW import libraries are commonly in lib/, with their DLLs in bin/.
    foreach (_zlib_library ${ZLIB_LIBRARY_${_conf_uc}} ${ZLIB_LIBRARY_RELEASE} ${ZLIB_LIBRARY})
      if (EXISTS "${_zlib_library}")
        get_filename_component (_zlib_library_dir "${_zlib_library}" DIRECTORY)
        foreach (_zlib_runtime_dir "${_zlib_library_dir}" "${_zlib_library_dir}/../bin")
          if (IS_DIRECTORY "${_zlib_runtime_dir}")
            get_filename_component (_zlib_runtime_dir "${_zlib_runtime_dir}" ABSOLUTE)
            list (APPEND _runtime_dirs "${_zlib_runtime_dir}")
          endif()
        endforeach()
      endif()
    endforeach()
  endif()
  list (FILTER _runtime_dirs EXCLUDE REGEX "^$")
  list (REMOVE_DUPLICATES _runtime_dirs)
  set (${output} "${_runtime_dirs}" PARENT_SCOPE)
endfunction()

function (occtviewer_generate_draw_runtime)
  set (_runtime_configs ${CMAKE_CONFIGURATION_TYPES} ${CMAKE_BUILD_TYPE})
  list (REMOVE_DUPLICATES _runtime_configs)
  set (_runtime_tcl_dirs "{$<TARGET_FILE_DIR:ViewDraw>}")
  if (NOT _runtime_configs)
    occtviewer_draw_runtime_dirs (_runtime_dirs "")
    foreach (_runtime_dir ${_runtime_dirs})
      string (APPEND _runtime_tcl_dirs " {${_runtime_dir}}")
    endforeach()
  else()
    foreach (_runtime_config ${_runtime_configs})
      occtviewer_draw_runtime_dirs (_runtime_dirs "${_runtime_config}")
      foreach (_runtime_dir ${_runtime_dirs})
        string (APPEND _runtime_tcl_dirs " $<$<CONFIG:${_runtime_config}>:{${_runtime_dir}}>")
      endforeach()
    endforeach()
  endif()
  file (GENERATE
    OUTPUT "$<TARGET_FILE_DIR:ViewDraw>/viewdraw-runtime.tcl"
    CONTENT "# Generated by CMake; source through test/cae/viewdraw_runtime.tcl.\nset ::ViewDrawRuntime::libraryFile {$<TARGET_FILE:ViewDraw>}\nset ::ViewDrawRuntime::libraryDirs [list ${_runtime_tcl_dirs}]\n")
endfunction()
