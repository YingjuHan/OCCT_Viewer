{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "description": "Default preset of build and install directory",
            "hidden": true,
            "installDir": "${sourceDir}/install",
            "cacheVariables": {
                "OCCTV_USE_MEDFILE": "ON",
                "OCCTV_BUILD_DRAW": "ON",
                "OCCTV_USE_DRACO": "ON",
                "OCCTV_WARNINGS_AS_ERRORS": "ON",
                "OpenCASCADE_ROOT_DIR": "${sourceDir}/../3rdparty/occt",
                "draco_ROOT_DIR": "${sourceDir}/../3rdparty/draco"
            }
        },
        {
            "name": "makefiles-debug",
            "description": "MinGW Makefiles preset for debug",
            "inherits": "default",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/work/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "OCCTV_USE_VSCODE": "ON"
            }
        },
        {
            "name": "makefiles-release",
            "description": "MinGW Makefiles preset for release",
            "inherits": "default",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/work/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "OCCTV_USE_VSCODE": "ON"
            }
        },
        {
            "name": "ninja-multi",
            "description": "Ninja Multi-Config preset",
            "inherits": "default",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/work/build-multi"
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "ninja-multi",
            "configuration": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "ninja-multi",
            "configuration": "Release"
        },
        {
            "name": "RelWithDebInfo",
            "configurePreset": "ninja-multi",
            "configuration": "RelWithDebInfo"
        }
    ]
}
