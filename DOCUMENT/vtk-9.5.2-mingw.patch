diff --git a/Common/Core/CMakeLists.txt b/Common/Core/CMakeLists.txt
index 0bc64843..1f5f4317 100644
--- a/Common/Core/CMakeLists.txt
+++ b/Common/Core/CMakeLists.txt
@@ -693,6 +693,18 @@ if (MSVC)
     PROPERTY
       COMPILE_OPTIONS /bigobj)
 elseif (MINGW)
+  if (CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
+    # Extern AOS template declarations also serve unoptimized consumers. Keep
+    # their inline dllexports when explicitly instantiating each scalar type.
+    foreach (vtk_scalar_array IN ITEMS
+        vtkCharArray vtkSignedCharArray vtkUnsignedCharArray
+        vtkShortArray vtkUnsignedShortArray vtkIntArray vtkUnsignedIntArray
+        vtkLongArray vtkUnsignedLongArray vtkLongLongArray vtkUnsignedLongLongArray
+        vtkFloatArray vtkDoubleArray)
+      set_property(SOURCE "${vtk_scalar_array}.cxx" APPEND
+        PROPERTY COMPILE_OPTIONS "-fkeep-inline-dllexport")
+    endforeach ()
+  endif ()
   check_cxx_compiler_flag("-Wa,-mbig-obj" VTK_HAS_MBIG_OBJ)
   mark_as_advanced(VTK_HAS_MBIG_OBJ)
   if (VTK_HAS_MBIG_OBJ)
